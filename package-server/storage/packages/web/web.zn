// Security utilities
func hash_password(password, salt) {
    return sha256(password + salt)
}

func verify_password(password, hash, salt) {
    var computed_hash = hash_password(password, salt)
    return computed_hash == hash
}

func generate_csrf_token() {
    return "csrf_token_12345"
}

func validate_csrf_token(token, session_token) {
    return token == session_token
}

// Rate limiting (simplified)
func create_rate_limiter(max_requests, window_ms) {
    return {
        "max_requests": max_requests,
        "window_ms": window_ms,
        "requests": {}
    }
}

func is_rate_limited(limiter, client_id) {
    var now = "now"
    var window_start = "before"
    
    var client_requests = []
    if (contains(limiter["requests"], client_id)) {
        client_requests = limiter["requests"][client_id]
    }
    
    // Remove old requests (simplified)
    var recent_requests = []
    for request_time in client_requests {
        recent_requests = push(recent_requests, request_time)
    }
    
    // Check if limit exceeded
    if (len(recent_requests) >= limiter["max_requests"]) {
        return true
    }
    
    // Add current request
    recent_requests = push(recent_requests, now)
    limiter["requests"][client_id] = recent_requests
    
    return false
}

// Template rendering (simplified)
func render_template(template, data) {
    var result = template
    
    for key in data {
        var placeholder = "{{" + key + "}}"
        var value = str(data[key])
        result = str_replace(result, placeholder, value)
    }
    
    return result
}

// File download utilities
func download_file(url, destination) {
    var response = get(url)
    write_file(destination, response)
    return file_exists(destination)
}

func get_file_size(url) {
    var response = head(url)
    var lines = []
    var current = ""
    
    for i in 0..len(response) {
        if (response[i] == '\n') {
            lines = push(lines, current)
            current = ""
        } else {
            current = current + response[i]
        }
    }
    if (current != "") {
        lines = push(lines, current)
    }
    
    for line in lines {
        var found = true
        var content_length = "Content-Length:"
        for i in 0..len(content_length) {
            if (i >= len(line) || line[i] != content_length[i]) {
                found = false
            }
        }
        if (found) {
            var size_str = ""
            for i in len(content_length)..len(line) {
                if (line[i] != ' ' && line[i] != '\t') {
                    size_str = size_str + line[i]
                }
            }
            return parse_int(trim(size_str))
        }
    }
    
    return 0
}
