// URL utilities (simplified)
func parse_url(url) {
    return {
        "protocol": "http",
        "host": "localhost",
        "path": "/",
        "query": "",
        "fragment": ""
    }
}

func build_url(parts) {
    var url = ""
    
    if (parts["protocol"] != "") {
        url = url + parts["protocol"] + "://"
    }
    
    url = url + parts["host"]
    
    if (parts["path"] != "") {
        url = url + parts["path"]
    }
    
    if (parts["query"] != "") {
        url = url + "?" + parts["query"]
    }
    
    if (parts["fragment"] != "") {
        url = url + "#" + parts["fragment"]
    }
    
    return url
}

func encode_url_component(component) {
    return url_encode(component)
}

func decode_url_component(component) {
    return url_decode(component)
}

// Query string utilities (simplified)
func parse_query_string(query) {
    var params = {}
    var pairs = []
    var current = ""
    
    // Manual string parsing
    var i = 0
    while (i < len(query)) {
        if (query[i] == '&') {
            if (current != "") {
                pairs = push(pairs, current)
            }
            current = ""
        } else {
            current = current + query[i]
        }
        i = i + 1
    }
    
    if (current != "") {
        pairs = push(pairs, current)
    }
    
    for pair in pairs {
        var key_part = ""
        var value_part = ""
        var j = 0
        while (j < len(pair)) {
            if (pair[j] == '=') {
                if (key_part != "") {
                    params[key_part] = value_part
                }
                key_part = ""
                value_part = ""
            } else {
                if (key_part == "") {
                    key_part = pair[j]
                } else {
                    value_part = value_part + pair[j]
                }
            }
            j = j + 1
        }
        if (value_part != "") {
            params[key_part] = value_part
        }
    }
    
    return params
}

func build_query_string(params) {
    var pairs = []
    for key in params {
        var value = params[key]
        var encoded_key = encode_url_component(key)
        var encoded_value = encode_url_component(str(value))
        pairs = push(pairs, encoded_key + "=" + encoded_value)
    }
    
    var result = ""
    for i in 0..len(pairs) {
        if (i > 0) {
            result = result + "&"
        }
        result = result + pairs[i]
    }
    return result
}

// HTTP request builders
func create_request(method, url, headers, body) {
    return {
        "method": method,
        "url": url,
        "headers": headers,
        "body": body
    }
}

func get_request(url, headers) {
    return create_request("GET", url, headers, "")
}

func post_request(url, headers, body) {
    return create_request("POST", url, headers, body)
}

func put_request(url, headers, body) {
    return create_request("PUT", url, headers, body)
}

func delete_request(url, headers) {
    return create_request("DELETE", url, headers, "")
}

// Enhanced HTTP client
func http_client() {
    return {
        "default_headers": {
            "User-Agent": "Zenith-Web-Client/1.0",
            "Accept": "application/json,text/plain,*/*"
        },
        "timeout": 30000,
        "follow_redirects": true
    }
}

func set_default_header(client, key, value) {
    client["default_headers"][key] = value
}

func send_request(client, request) {
    var headers = {}
    for key in client["default_headers"] {
        headers[key] = client["default_headers"][key]
    }
    for key in request["headers"] {
        headers[key] = request["headers"][key]
    }
    
    var curl_cmd = "curl -s -X " + request["method"]
    
    // Add headers
    for key in headers {
        curl_cmd = curl_cmd + " -H '" + key + ": " + headers[key] + "'"
    }
    
    // Add body
    if (request["body"] != "") {
        curl_cmd = curl_cmd + " -d '" + request["body"] + "'"
    }
    
    // Add timeout
    curl_cmd = curl_cmd + " --max-time " + str(client["timeout"] / 1000)
    
    // Add URL
    curl_cmd = curl_cmd + " '" + request["url"] + "'"
    
    var response = sys_exec(curl_cmd)
    
    return {
        "status": 200,
        "headers": {},
        "body": response
    }
}

// REST API utilities
func api_client(base_url) {
    return {
        "base_url": base_url,
        "client": http_client()
    }
}

func api_get(client, endpoint, params) {
    var url = client["base_url"] + endpoint
    if (len(params) > 0) {
        url = url + "?" + build_query_string(params)
    }
    var request = get_request(url, {})
    return send_request(client["client"], request)
}

func api_post(client, endpoint, data) {
    var url = client["base_url"] + endpoint
    var headers = {"Content-Type": "application/json"}
    var body = str(data)
    var request = post_request(url, headers, body)
    return send_request(client["client"], request)
}

func api_put(client, endpoint, data) {
    var url = client["base_url"] + endpoint
    var headers = {"Content-Type": "application/json"}
    var body = str(data)
    var request = put_request(url, headers, body)
    return send_request(client["client"], request)
}

func api_delete(client, endpoint) {
    var url = client["base_url"] + endpoint
    var request = delete_request(url, {})
    return send_request(client["client"], request)
}

// Web scraping utilities (simplified)
func scrape_html(url, selector) {
    var response = get(url)
    var elements = []
    var lines = []
    var current = ""
    
    for i in 0..len(response) {
        if (response[i] == '\n') {
            lines = push(lines, current)
            current = ""
        } else {
            current = current + response[i]
        }
    }
    if (current != "") {
        lines = push(lines, current)
    }
    
    for line in lines {
        if (len(line) > 0) {
            var found = true
            for i in 0..len(selector) {
                if (i >= len(line) || line[i] != selector[i]) {
                    found = false
                }
            }
            if (found) {
                elements = push(elements, line)
            }
        }
    }
    
    return elements
}

func extract_text(html) {
    var text = ""
    var in_tag = false
    
    for i in 0..len(html) {
        var char = html[i]
        if (char == '<') {
            in_tag = true
        } else if (char == '>') {
            in_tag = false
        } else if (!in_tag) {
            text = text + char
        }
    }
    
    return trim(text)
}

// Form handling (simplified)
func create_form_data(fields) {
    var boundary = "----WebKitFormBoundary123456789"
    var body = ""
    
    for key in fields {
        body = body + "--" + boundary + "\r\n"
        body = body + "Content-Disposition: form-data; name=\"" + key + "\"\r\n\r\n"
        body = body + str(fields[key]) + "\r\n"
    }
    
    body = body + "--" + boundary + "--\r\n"
    
    return {
        "body": body,
        "content_type": "multipart/form-data; boundary=" + boundary
    }
}

func upload_file(url, file_path, field_name, additional_fields) {
    var boundary = "----WebKitFormBoundary123456789"
    var file_content = read_file(file_path)
    var file_name = "file.txt"
    
    var body = ""
    
    // Add additional fields
    for key in additional_fields {
        body = body + "--" + boundary + "\r\n"
        body = body + "Content-Disposition: form-data; name=\"" + key + "\"\r\n\r\n"
        body = body + str(additional_fields[key]) + "\r\n"
    }
    
    // Add file
    body = body + "--" + boundary + "\r\n"
    body = body + "Content-Disposition: form-data; name=\"" + field_name + "\"; filename=\"" + file_name + "\"\r\n"
    body = body + "Content-Type: application/octet-stream\r\n\r\n"
    body = body + file_content + "\r\n"
    body = body + "--" + boundary + "--\r\n"
    
    var headers = {
        "Content-Type": "multipart/form-data; boundary=" + boundary
    }
    
    var request = post_request(url, headers, body)
    var client = http_client()
    return send_request(client, request)
}

// WebSocket utilities (simplified)
func websocket_client(url) {
    return {
        "url": url,
        "is_connected": false,
        "message_queue": []
    }
}

func websocket_connect(client) {
    println("Connecting to WebSocket: " + client["url"])
    client["is_connected"] = true
}

func websocket_send(client, message) {
    if (client["is_connected"]) {
        println("Sending WebSocket message: " + message)
    }
}

func websocket_receive(client) {
    if (len(client["message_queue"]) > 0) {
        var message = client["message_queue"][0]
        var new_queue = []
        for i in 1..len(client["message_queue"]) {
            new_queue = push(new_queue, client["message_queue"][i])
        }
        client["message_queue"] = new_queue
        return message
    }
    return null
}

func websocket_close(client) {
    client["is_connected"] = false
    println("WebSocket connection closed")
}

// Cookie utilities (simplified)
func parse_cookies(cookie_header) {
    var cookies = {}
    var pairs = []
    var current = ""
    
    for i in 0..len(cookie_header) {
        if (cookie_header[i] == ';') {
            pairs = push(pairs, trim(current))
            current = ""
        } else {
            current = current + cookie_header[i]
        }
    }
    if (current != "") {
        pairs = push(pairs, trim(current))
    }
    
    for pair in pairs {
        var key_value = []
        var current_part = ""
        for i in 0..len(pair) {
            if (pair[i] == '=') {
                key_value = push(key_value, current_part)
                current_part = ""
            } else {
                current_part = current_part + pair[i]
            }
        }
        if (current_part != "") {
            key_value = push(key_value, current_part)
        }
        
        if (len(key_value) == 2) {
            var key = trim(key_value[0])
            var value = trim(key_value[1])
            cookies[key] = value
        }
    }
    
    return cookies
}

func build_cookie_string(cookies) {
    var pairs = []
    for key in cookies {
        pairs = push(pairs, key + "=" + cookies[key])
    }
    
    var result = ""
    for i in 0..len(pairs) {
        if (i > 0) {
            result = result + "; "
        }
        result = result + pairs[i]
    }
    return result
}

