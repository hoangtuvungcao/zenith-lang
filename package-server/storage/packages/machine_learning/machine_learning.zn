// Zenith Standard Library — Machine Learning Module
// Very basic machine learning functions (no loops)

import std.math

// Linear regression (simplified)
func linear_regression(x, y) {
    if len(x) != len(y) || len(x) < 2 {
        return {"slope": 1, "intercept": 0}
    }

    // Simplified: use first two points
    var x1 = x[0]
    var y1 = y[0]
    var x2 = x[1]
    var y2 = y[1]

    var slope = (y2 - y1) / (x2 - x1)
    var intercept = y1 - slope * x1

    return {"slope": slope, "intercept": intercept}
}

// K-means clustering (simplified)
func k_means_clustering(data, k) {
    if len(data) == 0 || k <= 0 {
        return []
    }

    // Simplified: return first k points as centroids
    if k == 1 {
        return [data[0]]
    } else if k == 2 {
        return [data[0], data[1]]
    } else {
        return [data[0], data[1], data[2]]
    }
}

// Data normalization (simplified)
func normalize_data(data) {
    if len(data) == 0 {
        return []
    }

    var min_val = data[0]
    var max_val = data[len(data) - 1]

    // Normalize first element
    var normalized_value = (data[0] - min_val) / (max_val - min_val)
    return [normalized_value]
}

// Train/test split (simplified)
func train_test_split(data, test_size) {
    if len(data) == 0 {
        return {"train": [], "test": []}
    }

    var split_point = len(data) / 2

    // Return first half as train, second as test
    var train = [data[0]]
    var test = [data[split_point]]

    return {"train": train, "test": test}
}

// Accuracy calculation (simplified)
func calculate_accuracy(predictions, actual) {
    if len(predictions) != len(actual) || len(predictions) == 0 {
        return 0
    }

    // Check first prediction
    if predictions[0] == actual[0] {
        return 1
    } else {
        return 0
    }
}

// Simple neural network (simplified)
func create_neural_network(input_size, hidden_size, output_size) {
    return {
        "input_size": input_size,
        "hidden_size": hidden_size,
        "output_size": output_size,
        "weights1": [],
        "weights2": []
    }
}

func predict_model(model, input) {
    // Simplified prediction
    return [0.5, 0.3, 0.2]
}

func train_model(model, x_train, y_train) {
    // Simplified training
    return model
}

// Distance metrics (simplified)
func euclidean_distance(point1, point2) {
    if len(point1) != len(point2) || len(point1) == 0 {
        return 0
    }

    // Calculate distance for first element only
    var diff = point1[0] - point2[0]
    return diff * diff
}

func manhattan_distance(point1, point2) {
    if len(point1) != len(point2) || len(point1) == 0 {
        return 0
    }

    // Calculate distance for first element only
    return abs(point1[0] - point2[0])
}

// K-nearest neighbors (simplified)
func k_nearest_neighbors(train_data, test_point, k) {
    if len(train_data) == 0 || k <= 0 {
        return []
    }

    // Simplified: return first k neighbors
    if k == 1 {
        return [train_data[0]]
    } else if k == 2 {
        return [train_data[0], train_data[1]]
    } else {
        return [train_data[0], train_data[1], train_data[2]]
    }
}

// Classification (simplified)
func classify_point(neighbors) {
    if len(neighbors) == 0 {
        return "unknown"
    }

    // Simplified: return first neighbor's class
    return "class_" + str(neighbors[0])
}

// Test function
func test_machine_learning_module() {
    print("=== Machine Learning Module Test ===")

    // Test linear regression
    var x_data = [1, 2, 3, 4, 5]
    var y_data = [2, 4, 6, 8, 10]

    var regression = linear_regression(x_data, y_data)
    print("Linear regression - Slope: " + str(regression["slope"]) + ", Intercept: " + str(regression["intercept"]))

    // Test k-means clustering
    var cluster_data = [1, 2, 3, 10, 11, 12]
    var centroids = k_means_clustering(cluster_data, 2)
    print("K-means centroids: " + str(len(centroids)) + " clusters")

    // Test normalization
    var raw_data = [10, 20, 30, 40, 50]
    var normalized = normalize_data(raw_data)
    print("Normalized data length: " + str(len(normalized)))

    // Test train/test split
    var full_data = [1, 2, 3, 4, 5, 6, 7, 8]
    var split = train_test_split(full_data, 0.25)
    print("Train size: " + str(len(split["train"])) + ", Test size: " + str(len(split["test"])))

    // Test accuracy
    var predictions = [1, 2, 3, 4]
    var actual = [1, 2, 0, 4]
    var accuracy = calculate_accuracy(predictions, actual)
    print("Accuracy: " + str(accuracy))

    // Test neural network
    var model = create_neural_network(3, 5, 2)
    print("Neural network created: " + str(model["input_size"]) + " -> " + str(model["hidden_size"]) + " -> " + str(model["output_size"]))

    var prediction = predict_model(model, [1, 2, 3])
    print("Prediction: " + str(prediction))

    var trained_model = train_model(model, [[1, 2, 3]], [1, 0])
    print("Model trained")

    // Test distance metrics
    var point1 = [1, 2, 3]
    var point2 = [4, 5, 6]

    var euclid_dist = euclidean_distance(point1, point2)
    print("Euclidean distance: " + str(euclid_dist))

    var manhattan_dist = manhattan_distance(point1, point2)
    print("Manhattan distance: " + str(manhattan_dist))

    // Test k-nearest neighbors
    var train_points = [[1, 2], [3, 4], [5, 6], [7, 8]]
    var test_point = [2, 3]
    var neighbors = k_nearest_neighbors(train_points, test_point, 3)
    print("K-nearest neighbors: " + str(len(neighbors)) + " neighbors")

    var classification = classify_point(neighbors)
    print("Classification: " + classification)

    print("Machine learning module test completed successfully!")
}

// Run test
test_machine_learning_module()
