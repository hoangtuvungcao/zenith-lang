{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Zenith",
    "scopeName": "source.zenith",
    "fileTypes": [
        "zn"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.zenith",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.zenith",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.zenith",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zenith",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.zenith",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zenith",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.zenith",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.zenith",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zenith",
                    "match": "\\b(if|else|while|for|return|break|continue|match|in|import|export|from|as)\\b"
                },
                {
                    "name": "storage.type.function.zenith",
                    "match": "\\b(func)\\b"
                },
                {
                    "name": "storage.type.zenith",
                    "match": "\\b(var|let|const|struct|enum|trait|impl)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.zenith",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.zenith",
                    "match": "\\b(null)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.zenith",
                    "match": "\\b(int|float|string|bool|void|array|object|any|map)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.zenith",
                    "match": "\\b(print|println|len|str|range|sum|min|max|abs|sqrt|pow|sin|cos|tan|log|exp|floor|ceil|round|contains|index_of|slice|reverse_arr|unique|sort|filter|map|push|pop|shift|unshift)\\b"
                },
                {
                    "name": "support.module.zenith",
                    "match": "\\b(std\\.(array|math|string|json|http|crypto|datetime|encoding|validation|database|config|os|process|filesystem|io|net|web|ai|graphics|game|machine_learning|image_processing|physics|finance|chemistry|audio|statistics|logging|security))\\b"
                },
                {
                    "name": "meta.function-call.zenith",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.zenith"
                        }
                    }
                },
                {
                    "name": "meta.function-definition.zenith",
                    "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.zenith"
                        },
                        "2": {
                            "name": "entity.name.function.definition.zenith"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.zenith",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.comparison.zenith",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.zenith",
                    "match": "="
                },
                {
                    "name": "keyword.operator.logical.zenith",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "punctuation.separator.zenith",
                    "match": ",|;|\\.|:|->|=>"
                },
                {
                    "name": "punctuation.section.block.begin.zenith",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.block.end.zenith",
                    "match": "\\}"
                },
                {
                    "name": "punctuation.section.parens.begin.zenith",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.zenith",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.brackets.begin.zenith",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.brackets.end.zenith",
                    "match": "\\]"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.zenith",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}