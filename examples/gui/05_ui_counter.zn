
func build_ui(count) {
    return {
        "type": "Center",
        "child": {
            "type": "Container",
            "child": {
                "type": "Column",
                "children": [
                { "type": "Text", "text": "Zenith Counter App" } ,
                { "type": "Text", "text": "Current Count: " + count } ,
                {
                    "type": "Row",
                    "children": [
                    { "type": "Button", "label": " + ", "on_click": "inc" } ,
                    { "type": "Text", "text": " " } ,
                    { "type": "Button", "label": " - ", "on_click": "dec" }
                    ]
                }
                ]
            }
        }
    }
}

func main() {
    println("Starting Counter App...")
    var count_state = create_state(0)

    while (true) {
        var count = get_state(count_state)
        render_ui(build_ui(count))

        var event = wait_for_event()

        if (is_null(event) == false) {
            if (event["type"] == "click") {
                if (event["id"] == "inc") {
                    set_state(count_state, count + 1)
                } else if (event["id"] == "dec") {
                    set_state(count_state, count - 1)
                }
            }
        }
    }
}

main()
