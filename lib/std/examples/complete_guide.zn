print(" Fruits: " + str(fruits))print(" Sum of numbers: " + str(sum(numbers)))print(" Contains 3: " + str(contains(numbers, 3)))print(" Reverse: " + str(reverse_arr(numbers)))print("") // 3. Basic Operations print("3️⃣ Basic Operations:")import std.math var a = 10 var b = 3 print(" " + str(a) + " + " + str(b) + " = " + str(a + b))print(" " + str(a) + " - " + str(b) + " = " + str(a - b))print(" " + str(a) + " * " + str(b) + " = " + str(a * b))print(" " + str(a) + " / " + str(b) + " = " + str(a / b))print(" " + str(a) + " ^ " + str(b) + " = " + str(pow(a, b)))print(" abs(- 42)= " + str(abs( - 42)))print(" sqrt(16)= " + str(sqrt(16)))print("") // 4. String Operations print("4️⃣ String Operations:")import std.string var greeting = " Hello Zenith ! " print(" Original: '" + greeting + "'")print(" Trim: '" + trim(greeting) + "'")print(" Length: " + str(len(greeting)))print(" Starts with Hello: " + str(starts_with(greeting, "Hello")))print(" Uppercase: " + str_replace(greeting, "hello", "HELLO"))print("") //== == = PHẦN 2: CONTROL FLOW == == = print("PHẦN 2: CONTROL FLOW")print("") // 1. If - Else print("1️⃣ If - Else Statements:")var score = 85 if score >= 90 {
