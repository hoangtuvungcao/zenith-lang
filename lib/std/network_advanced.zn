// Zenith Standard Library — Advanced Network Module
// Advanced networking operations (no loops)

import std.net
import std.string
import std.json

// TCP Server operations
func create_tcp_server(port) {
    return {
        "server_type": "TCP",
        "port": port,
        "server_id": "tcp_server_" + str(port),
        "status": "running",
        "connections": 0
    }
}

func start_tcp_server(server) {
    server["status"] = "running"
    return "TCP server started on port " + str(server["port"])
}

func stop_tcp_server(server) {
    server["status"] = "stopped"
    return "TCP server stopped"
}

func accept_tcp_connection(server) {
    server["connections"] = server["connections"] + 1
    return {
        "connection_id": "conn_" + str(server["connections"]),
        "client_ip": "192.168.1.100",
        "client_port": 12345,
        "status": "connected"
    }
}

// TCP Client operations
func create_tcp_client(host, port) {
    return {
        "client_type": "TCP",
        "host": host,
        "port": port,
        "client_id": "tcp_client_" + str(port),
        "status": "connected"
    }
}

func connect_tcp_client(client) {
    client["status"] = "connected"
    return "Connected to " + client["host"] + ":" + str(client["port"])
}

func disconnect_tcp_client(client) {
    client["status"] = "disconnected"
    return "Disconnected from server"
}

func send_tcp_data(client, data) {
    if client["status"] == "connected" {
        return "Data sent: " + data + " (" + str(len(data)) + " bytes)"
    }
    return "ERROR: Client not connected"
}

func receive_tcp_data(client) {
    if client["status"] == "connected" {
        return "Received: Hello from server"
    }
    return "ERROR: Client not connected"
}

// UDP operations
func create_udp_socket(port) {
    return {
        "socket_type": "UDP",
        "port": port,
        "socket_id": "udp_socket_" + str(port),
        "status": "bound"
    }
}

func send_udp_data(socket, host, port, data) {
    return "UDP data sent to " + host + ":" + str(port) + " - " + data
}

func receive_udp_data(socket) {
    return "UDP data received: Hello from client"
}

// WebSocket operations
func create_websocket_connection(url) {
    return {
        "connection_type": "WebSocket",
        "url": url,
        "connection_id": "ws_" + str(len(url)),
        "status": "connected"
    }
}

func websocket_connect(ws_connection) {
    ws_connection["status"] = "connected"
    return "WebSocket connected to " + ws_connection["url"]
}

func websocket_disconnect(ws_connection) {
    ws_connection["status"] = "disconnected"
    return "WebSocket disconnected"
}

func websocket_send(ws_connection, message) {
    if ws_connection["status"] == "connected" {
        return "WebSocket message sent: " + message
    }
    return "ERROR: WebSocket not connected"
}

func websocket_receive(ws_connection) {
    if ws_connection["status"] == "connected" {
        return "WebSocket message received: Hello from server"
    }
    return "ERROR: WebSocket not connected"
}

// HTTP Server operations
func create_http_server(port, handler) {
    return {
        "server_type": "HTTP",
        "port": port,
        "handler": handler,
        "server_id": "http_server_" + str(port),
        "status": "running",
        "requests_handled": 0
    }
}

func start_http_server(server) {
    server["status"] = "running"
    return "HTTP server started on port " + str(server["port"])
}

func stop_http_server(server) {
    server["status"] = "stopped"
    return "HTTP server stopped"
}

func handle_http_request(server, method, path, headers, body) {
    server["requests_handled"] = server["requests_handled"] + 1
    
    var response = {
        "status_code": 200,
        "headers": {"Content-Type": "application/json"},
        "body": "{\"message\": \"Hello from HTTP server\", \"request\": \"" + method + " " + path + "\"}"
    }
    
    return response
}

// HTTP Client operations
func create_http_client() {
    return {
        "client_type": "HTTP",
        "client_id": "http_client_001",
        "default_headers": {"User-Agent": "Zenith-HTTP-Client/1.0"}
    }
}

func http_get(client, url, headers) {
    return {
        "method": "GET",
        "url": url,
        "status_code": 200,
        "headers": {"Content-Type": "application/json"},
        "body": "{\"data\": \"GET request successful\"}"
    }
}

func http_post(client, url, headers, body) {
    return {
        "method": "POST",
        "url": url,
        "status_code": 201,
        "headers": {"Content-Type": "application/json"},
        "body": "{\"message\": \"POST request successful\", \"received\": " + body + "}"
    }
}

func http_put(client, url, headers, body) {
    return {
        "method": "PUT",
        "url": url,
        "status_code": 200,
        "headers": {"Content-Type": "application/json"},
        "body": "{\"message\": \"PUT request successful\", \"updated\": " + body + "}"
    }
}

func http_delete(client, url, headers) {
    return {
        "method": "DELETE",
        "url": url,
        "status_code": 204,
        "headers": {},
        "body": ""
    }
}

// DNS operations
func dns_lookup(hostname) {
    return {
        "hostname": hostname,
        "ip_addresses": ["192.168.1.1", "192.168.1.2"],
        "lookup_time": 0.025
    }
}

func reverse_dns_lookup(ip_address) {
    return {
        "ip_address": ip_address,
        "hostname": "server.example.com",
        "lookup_time": 0.015
    }
}

// Network utilities
func get_local_ip() {
    return "192.168.1.100"
}

func get_public_ip() {
    return "203.0.113.1"
}

func ping_host(hostname) {
    return {
        "hostname": hostname,
        "status": "reachable",
        "response_time": 25.5,
        "packets_sent": 4,
        "packets_received": 4
    }
}

func scan_ports(host, start_port, end_port) {
    return {
        "host": host,
        "open_ports": [80, 443, 22, 8080],
        "closed_ports": [21, 23, 25, 110],
        "scan_time": 2.5
    }
}

// SSL/TLS operations
func create_ssl_context() {
    return {
        "context_type": "SSL",
        "protocol": "TLSv1.2",
        "cipher_suites": ["AES256-GCM-SHA384", "CHACHA20-POLY1305-SHA256"],
        "context_id": "ssl_ctx_001"
    }
}

func ssl_wrap_socket(socket, ssl_context) {
    return {
        "socket_type": "SSL",
        "original_socket": socket,
        "ssl_context": ssl_context,
        "status": "secure"
    }
}

func ssl_send_data(ssl_socket, data) {
    if ssl_socket["status"] == "secure" {
        return "SSL data sent: " + data + " (encrypted)"
    }
    return "ERROR: SSL socket not secure"
}

func ssl_receive_data(ssl_socket) {
    if ssl_socket["status"] == "secure" {
        return "SSL data received: Hello from secure server (decrypted)"
    }
    return "ERROR: SSL socket not secure"
}

// Network monitoring
func get_network_stats() {
    return {
        "bytes_sent": 1048576,
        "bytes_received": 2097152,
        "packets_sent": 1024,
        "packets_received": 2048,
        "connections_active": 5,
        "connections_total": 100
    }
}

func monitor_bandwidth(interface_name, duration) {
    return {
        "interface": interface_name,
        "duration_seconds": duration,
        "avg_bandwidth_mbps": 125.5,
        "peak_bandwidth_mbps": 250.0,
        "total_bytes": 15728640
    }
}

// Test function
func test_network_advanced_module() {
    print("=== Advanced Network Module Test ===")
    
    // Test TCP Server
    var tcp_server = create_tcp_server(8080)
    print("TCP Server created: " + tcp_server["server_id"])
    
    var server_start = start_tcp_server(tcp_server)
    print("TCP Server start: " + server_start)
    
    var connection = accept_tcp_connection(tcp_server)
    print("TCP Connection accepted: " + connection["connection_id"])
    
    var server_stop = stop_tcp_server(tcp_server)
    print("TCP Server stop: " + server_stop)
    
    // Test TCP Client
    var tcp_client = create_tcp_client("localhost", 8080)
    print("TCP Client created: " + tcp_client["client_id"])
    
    var client_connect = connect_tcp_client(tcp_client)
    print("TCP Client connect: " + client_connect)
    
    var send_result = send_tcp_data(tcp_client, "Hello Server!")
    print("TCP Send data: " + send_result)
    
    var receive_result = receive_tcp_data(tcp_client)
    print("TCP Receive data: " + receive_result)
    
    var client_disconnect = disconnect_tcp_client(tcp_client)
    print("TCP Client disconnect: " + client_disconnect)
    
    // Test UDP
    var udp_socket = create_udp_socket(9090)
    print("UDP Socket created: " + udp_socket["socket_id"])
    
    var udp_send = send_udp_data(udp_socket, "localhost", 9090, "Hello UDP!")
    print("UDP Send: " + udp_send)
    
    var udp_receive = receive_udp_data(udp_socket)
    print("UDP Receive: " + udp_receive)
    
    // Test WebSocket
    var ws_connection = create_websocket_connection("ws://localhost:8080/ws")
    print("WebSocket created: " + ws_connection["connection_id"])
    
    var ws_connect = websocket_connect(ws_connection)
    print("WebSocket connect: " + ws_connect)
    
    var ws_send = websocket_send(ws_connection, "Hello WebSocket!")
    print("WebSocket send: " + ws_send)
    
    var ws_receive = websocket_receive(ws_connection)
    print("WebSocket receive: " + ws_receive)
    
    var ws_disconnect = websocket_disconnect(ws_connection)
    print("WebSocket disconnect: " + ws_disconnect)
    
    // Test HTTP Server
    var http_server = create_http_server(3000, "default_handler")
    print("HTTP Server created: " + http_server["server_id"])
    
    var http_start = start_http_server(http_server)
    print("HTTP Server start: " + http_start)
    
    var http_response = handle_http_request(http_server, "GET", "/api/test", {}, "")
    print("HTTP Response: " + str(http_response["status_code"]))
    
    var http_stop = stop_http_server(http_server)
    print("HTTP Server stop: " + http_stop)
    
    // Test HTTP Client
    var http_client = create_http_client()
    print("HTTP Client created: " + http_client["client_id"])
    
    var get_response = http_get(http_client, "https://api.example.com/data", {})
    print("HTTP GET: " + str(get_response["status_code"]))
    
    var post_response = http_post(http_client, "https://api.example.com/data", {}, "{\"name\": \"test\"}")
    print("HTTP POST: " + str(post_response["status_code"]))
    
    var put_response = http_put(http_client, "https://api.example.com/data/1", {}, "{\"name\": \"updated\"}")
    print("HTTP PUT: " + str(put_response["status_code"]))
    
    var delete_response = http_delete(http_client, "https://api.example.com/data/1", {})
    print("HTTP DELETE: " + str(delete_response["status_code"]))
    
    // Test DNS
    var dns_result = dns_lookup("example.com")
    print("DNS lookup: " + dns_result["hostname"] + " -> " + dns_result["ip_addresses"][0])
    
    var reverse_dns = reverse_dns_lookup("192.168.1.1")
    print("Reverse DNS: " + reverse_dns["ip_address"] + " -> " + reverse_dns["hostname"])
    
    // Test Network Utilities
    var local_ip = get_local_ip()
    print("Local IP: " + local_ip)
    
    var public_ip = get_public_ip()
    print("Public IP: " + public_ip)
    
    var ping_result = ping_host("example.com")
    print("Ping: " + ping_result["hostname"] + " - " + str(ping_result["response_time"]) + "ms")
    
    var port_scan = scan_ports("localhost", 1, 1000)
    print("Port scan: " + str(len(port_scan["open_ports"])) + " open ports")
    
    // Test SSL/TLS
    var ssl_context = create_ssl_context()
    print("SSL Context: " + ssl_context["context_id"])
    
    var ssl_socket = ssl_wrap_socket({"socket_id": "socket_001"}, ssl_context)
    print("SSL Socket: " + ssl_socket["status"])
    
    var ssl_send = ssl_send_data(ssl_socket, "Secure data!")
    print("SSL Send: " + ssl_send)
    
    var ssl_receive = ssl_receive_data(ssl_socket)
    print("SSL Receive: " + ssl_receive)
    
    // Test Network Monitoring
    var net_stats = get_network_stats()
    print("Network stats: " + str(net_stats["bytes_sent"]) + " bytes sent")
    
    var bandwidth = monitor_bandwidth("eth0", 60)
    print("Bandwidth: " + str(bandwidth["avg_bandwidth_mbps"]) + " Mbps")
    
    print("Advanced network module test completed successfully!")
}

// Run test
test_network_advanced_module()
