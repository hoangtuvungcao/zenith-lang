// Zenith Standard Library — JSON Module
// High-level wrappers for native JSON functions

func parse(s) {
    if type(s) != "string" {
        return null
    }
    return json_parse(s)
}

func stringify(v) {
    return json_stringify(v)
}

func pretty(v) {
    // Basic pretty print logic (expandable in Zenith)
    return json_stringify(v)
}
